<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lecturer Attendance Dashboard</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <!-- Include Chart.js Library from CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script> 
    <style>
        /* Global Resets and Font */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f4f7fc;
            color: #333;
            line-height: 1.6;
            display: flex;
            min-height: 100vh;
            overflow-x: hidden; /* Prevent body scrollbar when sidebar transitions */
        }

        #search {
            width: 400px;
            height: 30px;
            border-radius: 4px;
            margin-left: 20px;
            padding: 0 10px; /* Added padding for input */
            border: 1px solid #ccc; /* Added border for input */
        }

        .search-btn{
            width: 90px;
            height: 30px;
            background-color: #3498db; /* Changed color to a softer blue */
            color: white;
            border: none; /* Removed default border */
            border-radius: 4px;
            cursor: pointer; /* Add pointer cursor */
            transition: background-color 0.2s ease; /* Smooth transition on hover */
        }

        .search-btn:hover {
            background-color: #2187c2; /* Darker blue on hover */
        }

        .search-btn a{
            text-decoration: none;
            color: white;
        }

        /* Sidebar */
        .sidebar {
            width: 250px;
            background-color: #2c3e50;
            color: #ecf0f1;
            padding: 20px 15px;
            height: 100vh;
            position: fixed;
            top: 0;
            left: 0;
            display: flex;
            flex-direction: column;
            transition: width 0.3s ease, transform 0.3s ease; /* Added transform for off-screen */
            overflow-x: hidden;
            z-index: 200; /* Ensure sidebar is above content if overlaying */
        }

        .sidebar-header {
            text-align: center;
            margin-bottom: 25px;
            padding: 0 5px;
        }

        .sidebar-header h2 {
            font-size: 1.5em;
            font-weight: 600;
            white-space: nowrap;
        }

        .sidebar-nav {
            flex-grow: 1;
            overflow-y: auto;
        }

        .sidebar-nav ul { list-style: none; }

        .sidebar-nav li a {
            display: flex;
            align-items: center;
            color: #bdc3c7;
            text-decoration: none;
            padding: 10px 12px;
            margin-bottom: 7px;
            border-radius: 5px;
            transition: background-color 0.2s ease, color 0.2s ease;
            font-size: 0.9em;
            white-space: nowrap;
        }

        .sidebar-nav li a i {
            margin-right: 12px;
            font-size: 1.1em;
            width: 20px;
            text-align: center;
        }

        .sidebar-nav li a .nav-text { /* Span for text to hide it */
            transition: opacity 0.2s ease;
        }

        .sidebar-nav li a:hover,
        .sidebar-nav li a.active {
            background-color: #34495e;
            color: #ffffff;
        }

        .sidebar-footer {
            margin-top: auto;
            padding-top: 15px;
            border-top: 1px solid #34495e;
        }

        .logout-button {
            background-color: #e74c3c;
            color: white;
            border: none;
            padding: 10px;
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 5px;
            cursor: pointer;
            font-size: 0.95em;
            font-weight: 500;
            transition: background-color 0.2s ease;
        }
        .logout-button i { margin-right: 8px; }
        .logout-button:hover { background-color: #c0392b; }


        /* Collapsed state for Sidebar (JS Toggled) */
        .sidebar.is-collapsed {
            width: 70px; /* Collapsed width */
        }

        .sidebar.is-collapsed .sidebar-header h2,
        .sidebar.is-collapsed .sidebar-nav li a .nav-text, /* Hide text */
        .sidebar.is-collapsed .logout-button .nav-text {
            opacity: 0;
            visibility: hidden;
            width: 0; /* Ensure it takes no space */
            overflow: hidden;
        }
        .sidebar.is-collapsed .sidebar-nav li a,
        .sidebar.is-collapsed .logout-button {
            justify-content: center;
        }
        .sidebar.is-collapsed .sidebar-nav li a i,
        .sidebar.is-collapsed .logout-button i {
            margin-right: 0;
        }


        /* Main Content Area */
        .main-content {
            flex-grow: 1;
            margin-left: 250px; /* Default sidebar width */
            padding: 25px;
            transition: margin-left 0.3s ease;
            overflow-y: auto;
        }

        /* When sidebar is collapsed */
        .main-content.sidebar-is-collapsed {
            margin-left: 70px; /* Collapsed sidebar width */
        }

        .main-content-header {
            display: flex;
            align-items: center;
            margin-bottom: 20px;
            flex-wrap: wrap; /* Allow wrapping for smaller screens */
        }
        .main-content-header h1 {
            font-size: 1.8em;
            color: #2c3e50;
            font-weight: 700;
            margin-left: 15px; /* Space from toggle */
        }
        #sidebarToggle {
            font-size: 1.5em;
            color: #2c3e50;
            cursor: pointer;
            padding: 5px;
        }


        /* Summary Cards Section */
        .summary-cards-container {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-bottom: 25px;
        }
        .summary-card {
            background-color: #ffffff;
            padding: 18px;
            border-radius: 8px;
            box-shadow: 0 3px 10px rgba(0, 0, 0, 0.06);
            text-align: center;
        }
        .summary-card h3 { font-size: 1em; color: #5a6a7e; margin-bottom: 8px; font-weight: 600; }
        .summary-card .value { font-size: 2.2em; font-weight: 700; color: #2c3e50; }
        .summary-card .percentage { font-size: 0.9em; margin-top: 5px; }
        .percentage-present { color: #27ae60; }
        .percentage-absent { color: #c0392b; }

        /* Section Styling */
        .content-section {
            background-color: #ffffff;
            padding: 20px;
            border-radius: 8px;
            box-shadow: 0 3px 10px rgba(0, 0, 0, 0.06);
            margin-bottom: 25px;
        }
        .logout-button a {
            color: white;
            text-decoration: none;
        }
        .content-section h2 { font-size: 1.3em; color: #2c3e50; margin-bottom: 18px; font-weight: 600; padding-bottom: 8px; border-bottom: 1px solid #e0e6ed; }

        /* Recent Activities */
        .activities-list { list-style: none; }
        .activity-item { display: flex; justify-content: space-between; align-items: center; padding: 10px 5px; border-bottom: 1px solid #f0f3f7; }
        .activity-item:last-child { border-bottom: none; }
        .activity-details .lecturer { font-weight: 500; color: #34495e; font-size: 0.95em; }
        .activity-details .time { font-size: 0.8em; color: #7f8c8d; margin-left: 5px; }
        .activity-status { padding: 3px 8px; border-radius: 12px; font-size: 0.75em; font-weight: 600; color: white; text-transform: uppercase; min-width: 65px; text-align: center; }
        .status-present { background-color: #27ae60; }
        .status-Absent { background-color: #e74c3c; }
        .status-late { background-color: #f39c12; }

        /* Charts Section */
        .charts-container { display: grid; grid-template-columns: 1fr; gap: 25px; }
        @media (min-width: 992px) { .charts-container { grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); } }
        .chart-box { text-align: center; }

        /* Styles for Chart.js canvas elements */
        /* The canvas should fill its parent wrapper now */
        .chart-box .chart-wrapper { /* New wrapper div for charts */
            position: relative;
            height: 250px; /* Set a fixed height for the chart container */
            width: 100%;
            margin: 10px auto 15px auto; /* Margin applied to the wrapper */
        }

        .chart-box canvas {
            max-width: 100%;
            position: absolute; /* Position canvas absolutely within its relative wrapper */
            top: 0;
            left: 0;
            width: 100% !important; /* Ensure canvas takes 100% width of wrapper */
            height: 100% !important; /* Ensure canvas takes 100% height of wrapper */
            display: block;
        }
        
        .chart-legend { display: flex; justify-content: center; flex-wrap: wrap; gap: 10px 15px; margin-top: 10px; font-size: 0.85em; }
        .legend-item { display: flex; align-items: center; }
        .legend-color-box { width: 12px; height: 12px; margin-right: 6px; border-radius: 2px; }


        /* --- Responsive Adjustments with CSS (can be complemented by JS) --- */
        /* Medium devices (tablets) */
        @media (max-width: 991.98px) {
            .main-content-header h1 { font-size: 1.6em; }
            .summary-card .value { font-size: 2em; }
            .content-section h2 { font-size: 1.2em; }
        }

        /* Small devices (landscape phones, some tablets) */
        @media (max-width: 767.98px) {
            .main-content-header form { /* Ensure search bar wraps on smaller screens */
                width: 100%;
                margin-top: 15px;
                margin-left: 0;
                display: flex;
                justify-content: center;
            }
            #search {
                width: calc(100% - 100px); /* Adjust width to accommodate button */
                margin-left: 0;
            }
            .search-btn {
                margin-left: 10px;
            }
        }


        /* Extra small devices (phones) */
        @media (max-width: 575.98px) {
            .main-content { padding: 15px; }
            .main-content-header h1 { font-size: 1.4em; margin-left: 10px; margin-bottom: 15px; }
            #sidebarToggle { font-size: 1.3em; }
            .summary-cards-container { grid-template-columns: 1fr; gap: 15px; }
            .summary-card { padding: 15px; }
            .summary-card .value { font-size: 1.8em; }
            .summary-card h3 { font-size: 0.9em; }
            .content-section { padding: 15px; }
            .content-section h2 { font-size: 1.1em; margin-bottom: 15px; }
            .activity-item { flex-direction: column; align-items: flex-start; gap: 5px; }
            .activity-details .lecturer { font-size: 0.9em;}
            .activity-details .time { font-size: 0.75em;}
            /* canvas specific adjustments */
            .chart-box .chart-wrapper {
                height: 200px; /* Smaller height for mobile charts */
            }
            .chart-legend { font-size: 0.8em; gap: 8px 12px;}
            .legend-color-box { width: 10px; height: 10px;}
        }
    </style>
</head>
<body>
    <aside class="sidebar" id="sidebarMenu">
        <div class="sidebar-header">
            <h2>Admin</h2>
        </div>
        <nav class="sidebar-nav">
            <ul>
                <li><a href="#" class="active"><i class="fas fa-tachometer-alt"></i> <span class="nav-text">Dashboard</span></a></li>
                <li><a href="/lecturers"><i class="fas fa-users"></i> <span class="nav-text">Lecturers</span></a></li>
                <li><a href="/schedule"><i class="fas fa-check"></i> <span class="nav-text">Schedule</span></a></li>
            </ul>
        </nav>
        <div class="sidebar-footer">
            <button class="logout-button"><i class="fas fa-sign-out-alt"></i> <span class="nav-text"><a href="/logout">Logout</a></span></button>
        </div>
    </aside>

    <main class="main-content" id="mainContentArea">
        <header class="main-content-header">
            <i id="sidebarToggle" class="fas fa-bars"></i>
            <h1>Lecturer Attendance Overview</h1>
            <form action="/search" method="POST">
                <input type="text" name="search" id="search" placeholder="Search">
                <button class="search-btn" type="submit">Search</button>
            </form>
        </header>

        <section class="summary-cards-container">
            <div class="summary-card">
                <h3>Total Lecturers</h3>
                <p class="value"><%= totalLecturers %></p>
            </div>
            <div class="summary-card">
                <h3>Percentage Present</h3>
                <p class="value"><%= presentPercentage %>%</p>
                <p class="percentage percentage-present">(<%= presentCount %> Lecturers)</p>
            </div>
            <div class="summary-card">
                <h3>Percentage Late</h3>
                <p class="value"><%= absentPercentage %>%</p>
                <p class="percentage percentage-absent">(<%= absentCount %> Lecturers)</p>
            </div>
            <div class="summary-card">
                <h3>Percentage Absent</h3>
                <p class="value"><%= absentPercentagex %>%</p>
                <p class="percentage percentage-absent">(<%= absentCountx %> Lecturers)</p>
            </div>
        </section>

        <div class="charts-container">
            <section class="content-section chart-box">
                <h2>Today's Attendance</h2>
                <!-- Chart.js will render here -->
                <div class="chart-wrapper">
                    <canvas id="todayAttendanceChart"></canvas>
                </div>
                <div class="chart-legend">
                    <div class="legend-item">
                        <span class="legend-color-box" style="background-color: #27ae60;"></span> Present (<span id="piePresentPercentage"></span>%)
                    </div>
                    <div class="legend-item">
                        <span class="legend-color-box" style="background-color: #f39c12;"></span> Late (<span id="pieAbsentPercentage"></span>%)
                    </div>
                </div>
            </section>

            <section class="content-section chart-box">
                <h2>Recent Activities</h2>
                <ul class="activities-list">
                    <% for(let item of recentEntries){%> 
                    <li class="activity-item">
                        <div class="activity-details">
                            <span class="lecturer"><%= item.username %></span> <span class="time">(<%= item.report_time %>)</span> <span class="lecturer"><%= item.course %></span>
                        </div>
                        <span class="activity-status status-<%= item.status %>"><%= item.status %></span>
                    </li>
                    <% } %>
                </ul>
            </section>
        </div>

        <section class="content-section chart-box">
            <h2>Daily Trend (Example Data)</h2>
            <!-- Chart.js will render here -->
            <div class="chart-wrapper">
                <canvas id="dailyTrendChart"></canvas>
            </div>
            <div class="chart-legend">
                <div class="legend-item">
                    <span class="legend-color-box" style="background-color: #27ae60;"></span> Present
                </div>
                <div class="legend-item">
                    <span class="legend-color-box" style="background-color: #f39c12;"></span> Late
                </div>
            </div>
        </section>
    </main>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const sidebar = document.getElementById('sidebarMenu');
            const mainContent = document.getElementById('mainContentArea');
            const sidebarToggle = document.getElementById('sidebarToggle');

            const MOBILE_BREAKPOINT = 768;

            function toggleSidebar() {
                sidebar.classList.toggle('is-collapsed');
                mainContent.classList.toggle('sidebar-is-collapsed');
            }

            function checkSidebarState() {
                if (window.innerWidth <= MOBILE_BREAKPOINT) {
                    if (!sidebar.classList.contains('is-collapsed')) {
                        sidebar.classList.add('is-collapsed');
                        mainContent.classList.add('sidebar-is-collapsed');
                    }
                } else {
                    // On larger screens, if it was collapsed by mobile auto-collapse, expand it
                    // This part can be customized if you want the sidebar to stay collapsed on desktop if the user explicitly collapsed it.
                    // For this example, it will remain in its last state or the default desktop state.
                }
            }

            if (sidebarToggle) {
                sidebarToggle.addEventListener('click', toggleSidebar);
            }

            checkSidebarState();

            let resizeTimeout;
            window.addEventListener('resize', () => {
                clearTimeout(resizeTimeout);
                resizeTimeout = setTimeout(checkSidebarState, 250);
            });


            // --- Chart.js Integration ---

            // Helper to parse EJS values from rendered HTML elements
            function parseEJSValue(selector) {
                const element = document.querySelector(selector);
                if (element) {
                    // Remove any percentage signs, commas, spaces, and convert to number
                    const value = element.textContent.replace(/[%, ]/g, '');
                    return parseFloat(value) || 0;
                }
                return 0;
            }

            function parseCountFromPercentageText(selector) {
                const element = document.querySelector(selector);
                if (element) {
                    const match = element.textContent.match(/\((\d+)\s+Lecturers\)/);
                    if (match && match[1]) {
                        return parseInt(match[1], 10);
                    }
                }
                return 0;
            }

            // Get data from the rendered HTML (assuming EJS values are correctly inserted)
            const presentPercentage = parseEJSValue('.summary-card:nth-child(2) .value');
            const absentPercentage = parseEJSValue('.summary-card:nth-child(3) .value');
            const presentCount = parseCountFromPercentageText('.summary-card:nth-child(2) .percentage');
            const absentCount = parseCountFromPercentageText('.summary-card:nth-child(3) .percentage');
            const totalCountForCharts = presentCount + absentCount; // For consistent percentage calculation

            // --- Today's Attendance Pie Chart ---
            const todayAttendanceCtx = document.getElementById('todayAttendanceChart');
            if (todayAttendanceCtx && totalCountForCharts > 0) { // Ensure we have data to draw
                new Chart(todayAttendanceCtx, {
                    type: 'pie',
                    data: {
                        labels: ['Present', 'Late'],
                        datasets: [{
                            data: [presentCount, absentCount], // Use actual counts
                            backgroundColor: ['#27ae60', '#f39c12'],
                            hoverOffset: 4
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false, // Allow the chart to take parent's size
                        plugins: {
                            legend: {
                                display: false, // Hide Chart.js default legend, as we have a custom one in HTML
                            },
                            tooltip: {
                                callbacks: {
                                    label: function(context) {
                                        let label = context.label || '';
                                        if (label) {
                                            label += ': ';
                                        }
                                        if (context.parsed !== null) {
                                            const value = context.parsed;
                                            const percentage = (value / totalCountForCharts * 100).toFixed(1);
                                            label += value + ' (' + percentage + '%)';
                                        }
                                        return label;
                                    }
                                }
                            }
                        },
                        layout: {
                            padding: {
                                top: 10, bottom: 10
                            }
                        }
                    }
                });

                // Update custom legend percentages dynamically
                document.getElementById('piePresentPercentage').textContent = presentPercentage.toFixed(1);
                document.getElementById('pieAbsentPercentage').textContent = absentPercentage.toFixed(1);
            } else if (todayAttendanceCtx) {
                 // If no data, display a message or hide the canvas parent
                const wrapper = todayAttendanceCtx.closest('.chart-wrapper');
                if (wrapper) {
                    wrapper.innerHTML = '<p style="text-align: center; padding: 20px;">No attendance data available for today.</p>';
                    wrapper.style.height = 'auto'; // Adjust wrapper height
                }
            }


            // --- Daily Trend Bar Chart ---
            const dailyTrendCtx = document.getElementById('dailyTrendChart');
            if (dailyTrendCtx) {
                // Mock data for daily trend (replace with EJS data if available, e.g., from an array passed to the template)
                const dailyLabels = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri'];
                const dailyPresentData = [15, 20, 18, 25, 17]; // Example counts or relative values
                const dailyAbsentData = [5, 3, 7, 2, 8]; // Example counts or relative values

                new Chart(dailyTrendCtx, {
                    type: 'bar',
                    data: {
                        labels: dailyLabels,
                        datasets: [
                            {
                                label: 'Present',
                                data: dailyPresentData,
                                backgroundColor: '#27ae60',
                                borderColor: '#27ae60',
                                borderWidth: 1
                            },
                            {
                                label: 'Late',
                                data: dailyAbsentData,
                                backgroundColor: '#f39c12',
                                borderColor: '#f39c12',
                                borderWidth: 1
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                display: false, // Using custom legend HTML
                            },
                            title: {
                                display: false, // Title is already in HTML h2
                            },
                            tooltip: {
                                mode: 'index',
                                intersect: false,
                                callbacks: {
                                    title: function(context) {
                                        return context[0].label;
                                    },
                                    label: function(context) {
                                        let label = context.dataset.label || '';
                                        if (label) {
                                            label += ': ';
                                        }
                                        return label + context.parsed.y;
                                    }
                                }
                            }
                        },
                        scales: {
                            x: {
                                stacked: true,
                                grid: {
                                    display: false // Hide x-axis grid lines
                                }
                            },
                            y: {
                                stacked: true,
                                beginAtZero: true,
                                title: {
                                    display: true,
                                    text: 'Number of Lecturers'
                                },
                                grid: {
                                    color: '#e0e6ed' // Light grid lines
                                }
                            }
                        }
                    }
                });
            }
        });
    </script>
</body>
</html>