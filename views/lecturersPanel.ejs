<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lecturer Attendance Dashboard - JS Enhanced</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        /* Global Resets and Font */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f4f7fc;
            color: #333;
            line-height: 1.6;
            display: flex;
            min-height: 100vh;
            overflow-x: hidden; /* Prevent body scrollbar when sidebar transitions */
        }

        .lecturer-card {
    background-color: #fff;
    border-radius: 10px;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    padding: 20px;
    margin-bottom: 20px; /* Space between multiple cards */
    width: 100%;
    max-width: 400px; /* Max width for the card */
    overflow: hidden; /* Ensures content fits within rounded corners */
}

.lecturer-profile {
    display: flex; /* Aligns image and text side-by-side */
    align-items: center; /* Vertically aligns items in the center */
    margin-bottom: 15px; /* Space below the profile section if there's a bio */
}

.profile-picture {
    border-radius: 50%; /* Makes the image circular */
    object-fit: cover; /* Ensures the image covers the area without distortion */
    margin-right: 15px; /* Space between the picture and the text */
}

.lecturer-card:not(.compact) .profile-picture {
    width: 100px;
    height: 100px;
    border: 3px solid #007bff; /* Optional: adds a border to the profile picture */
}

/* Specific styling for the compact card's profile picture */
.lecturer-card.compact .profile-picture {
    width: 60px;
    height: 60px;
    border: 2px solid #28a745;
}


.lecturer-info {
    display: flex;
    flex-direction: column; /* Stacks name, username, and department vertically */
}

.lecturer-name {
    margin: 0 0 5px 0; /* Removes default margin and adds a small bottom margin */
    font-size: 1.4em;
    color: #333;
}

.username {
    margin: 0 0 5px 0;
    font-size: 0.95em;
    color: #555;
    font-style: italic;
}

.department {
    margin: 0;
    font-size: 0.9em;
    color: #777;
    background-color: #e9ecef;
    padding: 3px 8px;
    border-radius: 5px;
    display: inline-block; /* So background only covers text */
    align-self: flex-start; /* Aligns to the start of the flex container */
}

.lecturer-bio {
    font-size: 0.9em;
    color: #666;
    line-height: 1.6;
}

/* Styles for the compact card */
.lecturer-card.compact .lecturer-profile {
    margin-bottom: 0; /* No bottom margin if it's just profile and name/username */
}

.lecturer-card.compact .lecturer-name {
    font-size: 1.2em;
}

.lecturer-card.compact .username {
    font-size: 0.9em;
}

/* Optional: Add a hover effect to the card */
.lecturer-card:hover {
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
    transform: translateY(-2px); /* Slight lift effect */
    transition: box-shadow 0.3s ease, transform 0.3s ease;
}

        #search {
            width: 400px;
            height: 30px;
            border-radius: 4px;
            margin-left: 20px;
        }

        .search-btn{
            width: 90px;
            height: 30px;
            background-color: blue;
            color: white;
            border-radius: 4px;
        }

        /* Sidebar */
        .sidebar {
            width: 250px;
            background-color: #2c3e50;
            color: #ecf0f1;
            padding: 20px 15px;
            height: 100vh;
            position: fixed;
            top: 0;
            left: 0;
            display: flex;
            flex-direction: column;
            transition: width 0.3s ease, transform 0.3s ease; /* Added transform for off-screen */
            overflow-x: hidden;
            z-index: 200; /* Ensure sidebar is above content if overlaying */
        }

        .sidebar-header {
            text-align: center;
            margin-bottom: 25px;
            padding: 0 5px;
        }

        .sidebar-header h2 {
            font-size: 1.5em;
            font-weight: 600;
            white-space: nowrap;
        }

        .sidebar-nav {
            flex-grow: 1;
            overflow-y: auto;
        }

        .sidebar-nav ul { list-style: none; }

        .sidebar-nav li a {
            display: flex;
            align-items: center;
            color: #bdc3c7;
            text-decoration: none;
            padding: 10px 12px;
            margin-bottom: 7px;
            border-radius: 5px;
            transition: background-color 0.2s ease, color 0.2s ease;
            font-size: 0.9em;
            white-space: nowrap;
        }

        .sidebar-nav li a i {
            margin-right: 12px;
            font-size: 1.1em;
            width: 20px;
            text-align: center;
        }

        .sidebar-nav li a .nav-text { /* Span for text to hide it */
            transition: opacity 0.2s ease;
        }

        .sidebar-nav li a:hover,
        .sidebar-nav li a.active {
            background-color: #34495e;
            color: #ffffff;
        }

        .sidebar-footer {
            margin-top: auto;
            padding-top: 15px;
            border-top: 1px solid #34495e;
        }

        .logout-button {
            background-color: #e74c3c;
            color: white;
            border: none;
            padding: 10px;
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 5px;
            cursor: pointer;
            font-size: 0.95em;
            font-weight: 500;
            transition: background-color 0.2s ease;
        }
        .logout-button i { margin-right: 8px; }
        .logout-button:hover { background-color: #c0392b; }


        /* Collapsed state for Sidebar (JS Toggled) */
        .sidebar.is-collapsed {
            width: 70px; /* Collapsed width */
        }

        .sidebar.is-collapsed .sidebar-header h2,
        .sidebar.is-collapsed .sidebar-nav li a .nav-text, /* Hide text */
        .sidebar.is-collapsed .logout-button .nav-text {
            opacity: 0;
            visibility: hidden;
            width: 0; /* Ensure it takes no space */
            overflow: hidden;
        }
         .sidebar.is-collapsed .sidebar-nav li a,
         .sidebar.is-collapsed .logout-button {
            justify-content: center;
        }
        .sidebar.is-collapsed .sidebar-nav li a i,
        .sidebar.is-collapsed .logout-button i {
            margin-right: 0;
        }


        /* Main Content Area */
        .main-content {
            flex-grow: 1;
            margin-left: 250px; /* Default sidebar width */
            padding: 25px;
            transition: margin-left 0.3s ease;
            overflow-y: auto;
        }

        /* When sidebar is collapsed */
        .main-content.sidebar-is-collapsed {
            margin-left: 70px; /* Collapsed sidebar width */
        }

        .logout-button a {
            color: white;
            text-decoration: none;
        }

        .main-content-header {
            display: flex;
            align-items: center;
            margin-bottom: 20px;
        }
        .main-content-header h1 {
            font-size: 1.8em;
            color: #2c3e50;
            font-weight: 700;
            margin-left: 15px; /* Space from toggle */
        }
        #sidebarToggle {
            font-size: 1.5em;
            color: #2c3e50;
            cursor: pointer;
            padding: 5px;
        }


        /* Summary Cards Section */
        .summary-cards-container {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-bottom: 25px;
        }
        .summary-card {
            background-color: #ffffff;
            padding: 18px;
            border-radius: 8px;
            box-shadow: 0 3px 10px rgba(0, 0, 0, 0.06);
            text-align: center;
        }
        .summary-card h3 { font-size: 1em; color: #5a6a7e; margin-bottom: 8px; font-weight: 600; }
        .summary-card .value { font-size: 2.2em; font-weight: 700; color: #2c3e50; }
        .summary-card .percentage { font-size: 0.9em; margin-top: 5px; }
        .percentage-present { color: #27ae60; }
        .percentage-absent { color: #c0392b; }

        /* Section Styling */
        .content-section {
            background-color: #ffffff;
            padding: 20px;
            border-radius: 8px;
            box-shadow: 0 3px 10px rgba(0, 0, 0, 0.06);
            margin-bottom: 25px;
        }
        .content-section h2 { font-size: 1.3em; color: #2c3e50; margin-bottom: 18px; font-weight: 600; padding-bottom: 8px; border-bottom: 1px solid #e0e6ed; }

        /* Recent Activities */
        .activities-list { list-style: none; }
        .activity-item { display: flex; justify-content: space-between; align-items: center; padding: 10px 5px; border-bottom: 1px solid #f0f3f7; }
        .activity-item:last-child { border-bottom: none; }
        .activity-details .lecturer { font-weight: 500; color: #34495e; font-size: 0.95em; }
        .activity-details .time { font-size: 0.8em; color: #7f8c8d; margin-left: 5px; }
        .activity-status { padding: 3px 8px; border-radius: 12px; font-size: 0.75em; font-weight: 600; color: white; text-transform: uppercase; min-width: 65px; text-align: center; }
        .status-present { background-color: #27ae60; }
        .status-absent { background-color: #e74c3c; }
        .status-late { background-color: #f39c12; }

        /* Charts Section */
        .charts-container { display: grid; grid-template-columns: 1fr; gap: 25px; }
        @media (min-width: 992px) { .charts-container { grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); } }
        .chart-box { text-align: center; }
        .pie-chart-css { width: 150px; height: 150px; border-radius: 50%; margin: 10px auto 15px auto; background-image: conic-gradient(#27ae60 0% 70%, #e74c3c 70% 100%); box-shadow: 0 2px 6px rgba(0,0,0,0.1); }
        .bar-chart-css-container { padding-top: 15px; }
        .bar-chart-css { display: flex; justify-content: space-around; align-items: flex-end; height: 160px; border-bottom: 1px solid #ccc; padding: 0 5px; margin-bottom: 10px; }
        .bar-css { width: 25px; background-color: #3498db; border-radius: 3px 3px 0 0; }
        .bar-css.present-bar { background-color: #27ae60; }
        .bar-css.absent-bar { background-color: #e74c3c; }
        .bar-label-css { font-size: 0.75em; color: #7f8c8d; margin-top: 6px; }
        .chart-legend { display: flex; justify-content: center; flex-wrap: wrap; gap: 10px 15px; margin-top: 10px; font-size: 0.85em; }
        .legend-item { display: flex; align-items: center; }
        .legend-color-box { width: 12px; height: 12px; margin-right: 6px; border-radius: 2px; }


        /* --- Responsive Adjustments with CSS (can be complemented by JS) --- */
        /* Medium devices (tablets) */
        @media (max-width: 991.98px) {
            /* Sidebar JS toggle will primarily handle this, but CSS can provide defaults */
            .main-content-header h1 { font-size: 1.6em; }
            .summary-card .value { font-size: 2em; }
            .content-section h2 { font-size: 1.2em; }
        }

        /* Small devices (landscape phones, some tablets) */
        /* The JS will handle the .is-collapsed state, so fixed width changes in CSS media queries for sidebar might not be needed as much */
        @media (max-width: 767.98px) {
            /* JS will toggle sidebar to 70px or user preference */
            /* If sidebar is overlayed by JS on mobile, main content margin won't change */
        }


        /* Extra small devices (phones) */
        @media (max-width: 575.98px) {
            .main-content { padding: 15px; }
            .main-content-header h1 { font-size: 1.4em; margin-left: 10px; margin-bottom: 15px; }
             #sidebarToggle { font-size: 1.3em; }
            .summary-cards-container { grid-template-columns: 1fr; gap: 15px; }
            .summary-card { padding: 15px; }
            .summary-card .value { font-size: 1.8em; }
            .summary-card h3 { font-size: 0.9em; }
            .content-section { padding: 15px; }
            .content-section h2 { font-size: 1.1em; margin-bottom: 15px; }
            .activity-item { flex-direction: column; align-items: flex-start; gap: 5px; }
            .activity-details .lecturer { font-size: 0.9em;}
            .activity-details .time { font-size: 0.75em;}
            .pie-chart-css { width: 120px; height: 120px; }
            .bar-chart-css { height: 140px; }
            .bar-css { width: 20px; }
            .bar-label-css { font-size: 0.7em; }
            .chart-legend { font-size: 0.8em; gap: 8px 12px;}
            .legend-color-box { width: 10px; height: 10px;}

            /* JS can also control this: Sidebar overlay on very small screens */
            .sidebar.is-mobile-overlay {
                transform: translateX(-100%); /* Initially off-screen */
                /* Add box-shadow for overlay effect if needed */
            }
            .sidebar.is-mobile-overlay.is-open {
                transform: translateX(0);
            }
            /* If sidebar overlays, main content doesn't need margin on mobile */
            .main-content.sidebar-is-mobile-overlay {
                margin-left: 0 !important;
            }
        }
    </style>
</head>
<body>
    <aside class="sidebar" id="sidebarMenu">
        <div class="sidebar-header">
            <h2>Admin</h2>
        </div>
        <nav class="sidebar-nav">
            <ul>
                <li><a href="/admin" class="active"><i class="fas fa-tachometer-alt"></i> <span class="nav-text">Dashboard</span></a></li>
                <li><a href="#"><i class="fas fa-users"></i> <span class="nav-text">Lecturers</span></a></li>
                <li><a href="/schedule"><i class="fas fa-check"></i> <span class="nav-text">Schedule</span></a></li>
            </ul>
        </nav>
        <div class="sidebar-footer">
            <button class="logout-button"><i class="fas fa-sign-out-alt"></i> <span class="nav-text"><a href="/logout">Logout</a></span></button>
        </div>
    </aside>

    <main class="main-content" id="mainContentArea">
        <header class="main-content-header">
            <i id="sidebarToggle" class="fas fa-bars"></i>
            <h1>Lecturers</h1>
        </header>
        <section class="lec-card">
            <% for(let item of lecturers){%> 
            <div class="lecturer-card">
                <div class="lecturer-profile">
                    <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcTe0D37I0NB2-cYRQSFiZ6MIucOyXi4yi9WAA&s" alt="Lecturer Profile Picture" class="profile-picture">
                    <div class="lecturer-info">
                        <h3 class="lecturer-name"><%= item.username %></h3>
                        <p class="username"><%= item.email %></p>
                        <p class="department">Computer Science</p>
                    </div>
                </div>

            </div>
            <% } %>
        </section>
    </main>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const sidebar = document.getElementById('sidebarMenu');
            const mainContent = document.getElementById('mainContentArea');
            const sidebarToggle = document.getElementById('sidebarToggle');

            const MOBILE_BREAKPOINT = 768; // Width in pixels to consider as "mobile" for sidebar behavior

            // Function to toggle sidebar
            function toggleSidebar() {
                sidebar.classList.toggle('is-collapsed');
                mainContent.classList.toggle('sidebar-is-collapsed');

                // Specific mobile overlay behavior (optional, can be refined)
                if (window.innerWidth <= MOBILE_BREAKPOINT) {
                    if (sidebar.classList.contains('is-collapsed')) {
                        // If collapsing on mobile, ensure it's fully hidden if it was an overlay
                        sidebar.classList.remove('is-mobile-overlay', 'is-open');
                        mainContent.classList.remove('sidebar-is-mobile-overlay');
                    } else {
                        // If expanding on mobile, treat as an overlay
                        // sidebar.classList.add('is-mobile-overlay', 'is-open');
                        // mainContent.classList.add('sidebar-is-mobile-overlay');
                        // For this example, we'll stick to the push/collapse behavior on mobile too
                        // as defined by .is-collapsed and .sidebar-is-collapsed
                    }
                }
            }

            // Function to set initial sidebar state based on window width
            function checkSidebarState() {
                if (window.innerWidth <= MOBILE_BREAKPOINT) {
                    if (!sidebar.classList.contains('is-collapsed')) {
                        sidebar.classList.add('is-collapsed');
                        mainContent.classList.add('sidebar-is-collapsed');
                    }
                } else {
                    // On larger screens, you might want it to default to open,
                    // unless the user explicitly collapsed it (requires local storage for persistence)
                    // For now, let's ensure it's open on desktop if it was auto-collapsed by resize.
                     if (sidebar.classList.contains('is-collapsed')) {
                        // Optional: if you want it to always expand on desktop resize
                        // sidebar.classList.remove('is-collapsed');
                        // mainContent.classList.remove('sidebar-is-collapsed');
                     }
                }
            }

            // Event listener for the toggle button
            if (sidebarToggle) {
                sidebarToggle.addEventListener('click', toggleSidebar);
            }

            // Check initial state on page load
            checkSidebarState();

            // Check state on window resize (with a simple debounce)
            let resizeTimeout;
            window.addEventListener('resize', () => {
                clearTimeout(resizeTimeout);
                resizeTimeout = setTimeout(checkSidebarState, 250); // Adjust debounce time as needed
            });
        });
    </script>
</body>
</html>